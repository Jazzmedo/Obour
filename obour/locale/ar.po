#: obour/app.py:43
msgid "This app is no longer saved in Obour."
msgstr "لم يعد هذا التطبيق محفوظًا في عبور."

#: obour/app.py:53 obour/ui/window.py:558
#, python-brace-format
msgid "Install sshfs on {host} to paste your files there"
msgstr "ثبّت sshfs على {host} لتلصق ملفاتك هناك"

#: obour/app.py:55
msgid "Open Obour, then the host's ⋮ menu → Set Up Host…"
msgstr "افتح عبور، ثم قائمة ⋮ الخاصة بالمضيف ← إعداد المضيف…"

#: obour/app.py:63
#, python-brace-format
msgid "{name}: GPU Acceleration turned off for {host}"
msgstr "{name}: عُطّل تسريع معالج الرسوميات لـ {host}"

#: obour/app.py:65
msgid "No window appeared with GPU Acceleration, which freezes waypipe on some hosts. Trying Wayland again without it."
msgstr "لم تظهر أي نافذة مع تسريع معالج الرسوميات، وهو يجمّد waypipe على بعض المضيفات. تجري إعادة المحاولة عبر Wayland بدونه."

#: obour/app.py:71 obour/ui/window.py:651
#, python-brace-format
msgid "no Wayland window appeared within {seconds} seconds"
msgstr "لم تظهر نافذة Wayland خلال {seconds} ثانية"

#: obour/app.py:73 obour/ui/window.py:679
#, python-brace-format
msgid "{name}: Wayland failed, using X11"
msgstr "{name}: فشل Wayland، يُستخدم X11"

#: obour/app.py:74 obour/ui/window.py:673
#, python-brace-format
msgid "{name} couldn't open over Wayland ({reason}), so Obour is opening it with X11 instead. If that works, Obour remembers it for this app. To stop this, turn off “Try X11 When Wayland Fails” in Preferences."
msgstr "تعذّر فتح {name} عبر Wayland ({reason})، لذا يفتحه عبور عبر X11 بدلًا منه. إن نجح ذلك يتذكّره عبور لهذا التطبيق. لإيقاف ذلك عطّل «جرّب X11 عند فشل Wayland» في التفضيلات."

#: obour/app.py:91 obour/ui/window.py:573
msgid "Allow"
msgstr "اسمح"

#: obour/app.py:92 obour/ui/window.py:572
msgid "Don't Allow"
msgstr "لا تسمح"

#: obour/app.py:93 obour/ui/window.py:567
#, python-brace-format
msgid "Copy Files With {host}?"
msgstr "نسخ الملفات مع {host}؟"

#: obour/app.py:94 obour/ui/window.py:568
#, python-brace-format
msgid "While {name} runs, you can copy and paste files between this computer and {host}. The host can read the files you copy (read-only) during that time."
msgstr "أثناء تشغيل {name} يمكنك نسخ الملفات ولصقها بين هذا الحاسوب و{host}. يستطيع المضيف خلال ذلك قراءة ملفاتك التي تنسخها (قراءة فقط)."

#: obour/app.py:133
#, python-brace-format
msgid "Couldn't start {name}"
msgstr "تعذّر تشغيل {name}"

#: obour/app.py:192
#, python-brace-format
msgid "{name} stopped"
msgstr "توقّف {name}"

#: obour/app.py:197
#, python-brace-format
msgid "{host} needs a password. Open Obour and launch it once to log in."
msgstr "يحتاج {host} إلى كلمة مرور. افتح عبور وشغّل التطبيق منه مرة واحدة لتسجيل الدخول."

#: obour/app.py:249
#, python-brace-format
msgid "Backed up {count} app to {path}"
msgid_plural "Backed up {count} apps to {path}"
msgstr[0] "لم يُنسخ أي تطبيق إلى {path}"
msgstr[1] "نُسخ تطبيق واحد إلى {path}"
msgstr[2] "نُسخ تطبيقان إلى {path}"
msgstr[3] "نُسخت {count} تطبيقات إلى {path}"
msgstr[4] "نُسخ {count} تطبيقًا إلى {path}"
msgstr[5] "نُسخ {count} تطبيق إلى {path}"

#: obour/app.py:271
#, python-brace-format
msgid "Restored {count} app from {date}"
msgid_plural "Restored {count} apps from {date}"
msgstr[0] "لم يُستعد أي تطبيق من {date}"
msgstr[1] "استُعيد تطبيق واحد من {date}"
msgstr[2] "استُعيد تطبيقان من {date}"
msgstr[3] "استُعيدت {count} تطبيقات من {date}"
msgstr[4] "استُعيد {count} تطبيقًا من {date}"
msgstr[5] "استُعيد {count} تطبيق من {date}"

#: obour/backup.py:141 obour/backup.py:144
msgid "This isn’t an Obour backup."
msgstr "هذا ليس ملف نسخة احتياطية من عبور."

#: obour/backup.py:147
msgid "This backup was made by a newer Obour. Update Obour to restore it."
msgstr "صُنعت هذه النسخة الاحتياطية بإصدار أحدث من عبور. حدّث عبور لاستعادتها."

#: obour/backup.py:153
#, python-brace-format
msgid "This backup has an unsafe file in it: {name}"
msgstr "في هذه النسخة الاحتياطية ملف غير آمن: {name}"

#: obour/backup.py:196
#, python-brace-format
msgid "Your previous setup was saved to {path}"
msgstr "حُفظ إعدادك السابق في {path}"

#: obour/backup.py:238
#, python-brace-format
msgid "Restored your SSH key {path}"
msgstr "استُعيد مفتاح SSH الخاص بك {path}"

#: obour/backup.py:244
#, python-brace-format
msgid "You already have a different SSH key in {path}; the backup’s key was saved as {kept}"
msgstr "لديك مفتاح SSH مختلف في {path}، فحُفظ مفتاح النسخة الاحتياطية باسم {kept}"

#: obour/desktop.py:92
#, python-brace-format
msgid "Runs on {host} via Obour"
msgstr "يعمل على {host} عبر عبور"

#: obour/hostsetup.py:33
msgid "Shows Wayland apps (Firefox, GTK 4, Qt 6…)"
msgstr "يعرض تطبيقات Wayland ‏(Firefox وGTK 4 وQt 6…)"

#: obour/hostsetup.py:35
msgid "Shows X11 apps"
msgstr "يعرض تطبيقات X11"

#: obour/hostsetup.py:37
msgid "PulseAudio client library"
msgstr "مكتبة عميل PulseAudio"

#: obour/hostsetup.py:38
msgid "Plays sound here. Works with PipeWire or PulseAudio on this computer"
msgstr "يشغّل الصوت هنا. يعمل مع PipeWire أو PulseAudio على هذا الحاسوب"

#: obour/hostsetup.py:40
msgid "ALSA sound plugin"
msgstr "إضافة الصوت لـALSA"

#: obour/hostsetup.py:41
msgid "Plays sound here from apps that use ALSA directly"
msgstr "يشغّل هنا صوت التطبيقات التي تستخدم ALSA مباشرة"

#: obour/hostsetup.py:44
msgid "D-Bus session tool"
msgstr "أداة جلسة D-Bus"

#: obour/hostsetup.py:45
msgid "Opens apps as separate windows instead of reusing a copy running on the host"
msgstr "يفتح التطبيقات في نوافذ منفصلة بدل إعادة استخدام نسخة تعمل على المضيف"

#: obour/hostsetup.py:48
msgid "Lists the host's apps in the app browser"
msgstr "يسرد تطبيقات المضيف في متصفح التطبيقات"

#: obour/hostsetup.py:50
msgid "Dark style for Qt 5 apps"
msgstr "نمط داكن لتطبيقات Qt 5"

#: obour/hostsetup.py:51
msgid "Dark mode for Qt 5 apps such as VLC"
msgstr "الوضع الداكن لتطبيقات Qt 5 مثل VLC"

#: obour/hostsetup.py:55
msgid "GTK theme for Qt 6 apps"
msgstr "سمة GTK لتطبيقات Qt 6"

#: obour/hostsetup.py:55
msgid "Light/dark style for Qt 6 apps"
msgstr "النمط الفاتح/الداكن لتطبيقات Qt 6"

#: obour/hostsetup.py:58
msgid "GTK theme for Qt 5 apps"
msgstr "سمة GTK لتطبيقات Qt 5"

#: obour/hostsetup.py:59
msgid "Fonts and file dialogs for Qt 5 apps"
msgstr "الخطوط ونوافذ اختيار الملفات لتطبيقات Qt 5"

#: obour/hostsetup.py:63
msgid "Your colors, icons and fonts in Qt 6 apps"
msgstr "ألوانك وأيقوناتك وخطوطك في تطبيقات Qt 6"

#: obour/hostsetup.py:66
msgid "Your colors, icons and fonts in Qt 5 apps"
msgstr "ألوانك وأيقوناتك وخطوطك في تطبيقات Qt 5"

#: obour/hostsetup.py:69
msgid "KDE Plasma integration"
msgstr "تكامل KDE Plasma"

#: obour/hostsetup.py:69
msgid "Your KDE colors and fonts in Qt apps"
msgstr "ألوان KDE وخطوطك في تطبيقات Qt"

#: obour/hostsetup.py:73
msgid "The Breeze style for Qt apps"
msgstr "نمط Breeze لتطبيقات Qt"

#: obour/hostsetup.py:76
msgid "LXQt Qt plugin"
msgstr "إضافة LXQt لـ Qt"

#: obour/hostsetup.py:76
msgid "Your LXQt colors and icons in Qt apps"
msgstr "ألوان LXQt وأيقوناتك في تطبيقات Qt"

#: obour/hostsetup.py:79
msgid "Your Kvantum style in Qt apps"
msgstr "نمط Kvantum الخاص بك في تطبيقات Qt"

#: obour/hostsetup.py:82
msgid "Breeze icons"
msgstr "أيقونات Breeze"

#: obour/hostsetup.py:83
msgid "Icons your icon theme borrows from Breeze"
msgstr "أيقونات تستعيرها سمة أيقوناتك من Breeze"

#: obour/hostsetup.py:86
msgid "Your GTK settings on hosts without dconf"
msgstr "إعدادات GTK الخاصة بك على المضيفات التي لا تحوي dconf"

#: obour/hostsetup.py:86
msgid "dconf tools"
msgstr "أدوات dconf"

#: obour/hostsetup.py:88
msgid "Copy and paste files between the computers"
msgstr "نسخ الملفات ولصقها بين الحاسوبين"

#: obour/hostsetup.py:168
msgid "Obour doesn't know this host's package manager. Install the missing tools on the host yourself."
msgstr "لا يعرف عبور مدير الحزم لهذا المضيف. ثبّت الأدوات الناقصة على المضيف بنفسك."

#: obour/hostsetup.py:185
msgid "sudo isn't installed on the host, so Obour can't install packages. Log in as root, or install them yourself."
msgstr "برنامج sudo غير مثبّت على المضيف، لذا لا يستطيع عبور تثبيت الحزم. سجّل الدخول بحساب root، أو ثبّتها بنفسك."

#: obour/hostsetup.py:201 obour/launch.py:415 obour/look.py:675
#: obour/remote.py:94 obour/remote.py:225 obour/remote.py:334
#, python-brace-format
msgid "`{program}` is not installed on this computer."
msgstr "البرنامج `{program}` غير مثبّت على هذا الحاسوب."

#: obour/hostsetup.py:221
msgid "Wrong password for sudo on the host."
msgstr "كلمة مرور sudo على المضيف خاطئة."

#: obour/hostsetup.py:223
msgid "Your user on the host isn't allowed to use sudo. Ask an administrator to install the packages."
msgstr "لا يُسمح لمستخدمك على المضيف باستخدام sudo. اطلب من مسؤول النظام تثبيت الحزم."

#: obour/hostsetup.py:226
msgid "sudo on the host needs your password."
msgstr "يحتاج sudo على المضيف إلى كلمة مرورك."

#: obour/hostsetup.py:230
msgid "Another program on the host is installing software. Try again later."
msgstr "برنامج آخر على المضيف يثبّت برمجيات الآن. حاول لاحقًا."

#: obour/hostsetup.py:232
#, python-brace-format
msgid "Installing failed (exit code {code}). See the log for details."
msgstr "فشل التثبيت (رمز الخروج {code}). راجع السجل للتفاصيل."

#: obour/launch.py:118
msgid "Wayland and X11"
msgstr "Wayland وX11"

#: obour/launch.py:119 obour/ui/settings_rows.py:21
#: obour/ui/settings_rows.py:32
msgid "Automatic"
msgstr "تلقائي"

#: obour/launch.py:157
#, python-brace-format
msgid "Using X11 for {name}: it didn't work over Wayland before (Edit… → Try Wayland Again)."
msgstr "يُستخدم X11 لـ{name}: لم يعمل عبر Wayland سابقًا (تحرير… ← جرّب Wayland مجددًا)."

#: obour/launch.py:162
msgid "Wayland forwarding needs a Wayland session on this computer. Set this app's display mode to X11 or Automatic."
msgstr "يتطلب تمرير Wayland جلسة Wayland على هذا الحاسوب. اضبط وضع العرض لهذا التطبيق على X11 أو «تلقائي»."

#: obour/launch.py:165
msgid "waypipe is not installed on this computer; it is needed for Wayland forwarding."
msgstr "برنامج waypipe غير مثبّت على هذا الحاسوب، وهو لازم لتمرير Wayland."

#: obour/launch.py:180
#, python-brace-format
msgid "waypipe isn't installed on {host}; using X11 forwarding instead."
msgstr "برنامج waypipe غير مثبّت على {host}؛ سيُستخدم تمرير X11 بدلًا منه."

#: obour/launch.py:208
#, python-brace-format
msgid "Copied your cursor theme ({theme}) to {host}."
msgstr "نُسخت سمة المؤشر ({theme}) إلى {host}."

#: obour/launch.py:211
#, python-brace-format
msgid "Couldn't copy your cursor theme to {host}: {error}"
msgstr "تعذّر نسخ سمة المؤشر إلى {host}: {error}"

#: obour/launch.py:224
#, python-brace-format
msgid "Couldn't read your desktop's look: {error}"
msgstr "تعذّرت قراءة مظهر سطح مكتبك: {error}"

#: obour/launch.py:229
#, python-brace-format
msgid "Couldn't copy your desktop's look to {host}: {error}"
msgstr "تعذّر نسخ مظهر سطح مكتبك إلى {host}: {error}"

#: obour/launch.py:459
#, python-brace-format
msgid "Apps that use ALSA directly have no sound until the ALSA sound plugin is installed on {host} (⋮ → Set Up Host…)."
msgstr "التطبيقات التي تستخدم ALSA مباشرة بلا صوت حتى تُثبَّت إضافة الصوت لـALSA على {host} (⋮ ← إعداد المضيف…)."

#: obour/launch.py:463
msgid "No local PipeWire/PulseAudio socket found; launching without sound."
msgstr "لم يُعثر على مقبس PipeWire/PulseAudio محلي؛ سيُشغَّل التطبيق دون صوت."

#: obour/launch.py:497
#, python-brace-format
msgid "Qt 5 apps on {host} stay light until a dark Qt style is installed there (⋮ → Set Up Host…)."
msgstr "تبقى تطبيقات Qt 5 على {host} فاتحة حتى يُثبَّت عليه نمط Qt داكن (⋮ ← إعداد المضيف…)."

#: obour/launch.py:505
msgid "Install `x11-xserver-utils` (xsetroot) on this computer so Qt 5 apps like VLC show your cursor."
msgstr "ثبّت `x11-xserver-utils` (xsetroot) على هذا الحاسوب لتُظهر تطبيقات Qt 5 مثل VLC مؤشرك."

#: obour/launch.py:575
#, python-brace-format
msgid "GPU Acceleration is off for {host}: Wayland apps showed no window with it there."
msgstr "تسريع معالج الرسوميات معطّل لـ {host}: لم تُظهر تطبيقات Wayland أي نافذة معه هناك."

#: obour/launch.py:582
msgid "H.264 video needs GPU Acceleration (Preferences); using LZ4 compression instead."
msgstr "يتطلب فيديو H.264 تفعيل تسريع معالج الرسوميات (التفضيلات)؛ سيُستخدم ضغط LZ4 بدلًا منه."

#: obour/launch.py:623
#, python-brace-format
msgid "Files can be copied, pasted and dragged between this computer and {name} while it runs."
msgstr "يمكن نسخ الملفات ولصقها وسحبها بين هذا الحاسوب و{name} ما دام يعمل."

#: obour/launch.py:626
#, python-brace-format
msgid "Files can be copied and pasted with {host} while {name} runs."
msgstr "يمكن نسخ الملفات ولصقها مع {host} ما دام {name} يعمل."

#: obour/launch.py:672
msgid "it crashed"
msgstr "تعطّل"

#: obour/launch.py:677
msgid "it couldn't connect to the Wayland display"
msgstr "تعذّر اتصاله بشاشة Wayland"

#: obour/launch.py:680
#, python-brace-format
msgid "it stopped with exit code {code}"
msgstr "توقّف برمز الخروج {code}"

#: obour/launch.py:689
msgid "waypipe isn't installed on the host. Install it there, or set this app's display mode to X11."
msgstr "برنامج waypipe غير مثبّت على المضيف. ثبّته هناك، أو اضبط وضع العرض لهذا التطبيق على X11."

#: obour/launch.py:692
msgid "The host refused X11 forwarding. Set `X11Forwarding yes` in /etc/ssh/sshd_config on the host and make sure `xauth` is installed there."
msgstr "رفض المضيف تمرير X11. اضبط `X11Forwarding yes` في ‎/etc/ssh/sshd_config على المضيف وتأكد من تثبيت `xauth` هناك."

#: obour/launch.py:699
msgid "The app couldn't open a Wayland window. It may only support X11; try setting its display mode to X11."
msgstr "تعذّر على التطبيق فتح نافذة Wayland. ربما يدعم X11 فقط؛ جرّب ضبط وضع العرض له على X11."

#: obour/launch.py:701
msgid "The app couldn't open the forwarded X11 display. Make sure `xauth` is installed on the host."
msgstr "تعذّر على التطبيق فتح شاشة X11 الممرَّرة. تأكد من تثبيت `xauth` على المضيف."

#: obour/launch.py:708
msgid "The app is already running on the host and refused to start a second copy (for example Firefox with the same profile). Close it there, or turn off “Separate Instance” in this app's settings to open a window of the running copy."
msgstr "التطبيق يعمل بالفعل على المضيف ورفض بدء نسخة ثانية (مثل Firefox بالملف الشخصي نفسه). أغلقه هناك، أو عطّل «نسخة منفصلة» في إعدادات هذا التطبيق لفتح نافذة من النسخة العاملة."

#: obour/launch.py:713
msgid "The command wasn't found on the host. Check the command in this app's settings."
msgstr "لم يُعثر على الأمر على المضيف. تحقّق من الأمر في إعدادات هذا التطبيق."

#: obour/launch.py:717
#, python-brace-format
msgid "The app crashed on the host: {line}"
msgstr "تعطّل التطبيق على المضيف: {line}"

#: obour/launch.py:719
#, python-brace-format
msgid "The app stopped with exit code {code}."
msgstr "توقّف التطبيق برمز الخروج {code}."

#: obour/launch.py:721
#, python-brace-format
msgid "Last message: {line}"
msgstr "آخر رسالة: {line}"

#: obour/launch.py:748
#, python-brace-format
msgid "Connecting to {host} ({protocol}, with sound)…"
msgstr "جارٍ الاتصال بـ {host} ‏({protocol}، مع الصوت)…"

#: obour/launch.py:749
#, python-brace-format
msgid "Connecting to {host} ({protocol})…"
msgstr "جارٍ الاتصال بـ {host} ‏({protocol})…"

#: obour/look.py:126
msgid "Unknown desktop"
msgstr "سطح مكتب غير معروف"

#: obour/look.py:643
#, python-brace-format
msgid "Copying your desktop look to {host} (first time, {size:.0f} MB)…"
msgstr "يجري نسخ مظهر سطح مكتبك إلى {host} (أول مرة، {size:.0f} م.ب)…"

#: obour/look.py:673
msgid "Timed out while copying your desktop look."
msgstr "انتهت المهلة أثناء نسخ مظهر سطح مكتبك."

#: obour/remote.py:24
msgid "The host needs a password"
msgstr "يحتاج المضيف إلى كلمة مرور"

#: obour/remote.py:47
msgid "The host is not reachable from this network (connection timed out)."
msgstr "لا يمكن الوصول إلى المضيف من هذه الشبكة (انتهت مهلة الاتصال)."

#: obour/remote.py:68
msgid "(no working SSH key). Log in once with the password and Obour can set up key login so you won't need it again."
msgstr "(لا يوجد مفتاح SSH صالح). سجّل الدخول مرة واحدة بكلمة السر ويمكن لعبور إعداد الدخول بالمفتاح كي لا تحتاج إليها مجددًا."

#: obour/remote.py:72
msgid "Host not found. Check the hostname, or add it to ~/.ssh/config."
msgstr "لم يُعثر على المضيف. تحقّق من اسم المضيف، أو أضفه إلى ‎~/.ssh/config."

#: obour/remote.py:74
msgid "Connection refused. Is the SSH server running on the remote machine?"
msgstr "رُفض الاتصال. هل خادم SSH يعمل على الجهاز البعيد؟"

#: obour/remote.py:78
msgid "The host's key has changed since your last connection. If that is expected, remove the old key with `ssh-keygen -R <host>`."
msgstr "تغيّر مفتاح المضيف منذ آخر اتصال. إن كان ذلك متوقعًا، فاحذف المفتاح القديم بالأمر `ssh-keygen -R <host>`."

#: obour/remote.py:81
msgid "Unknown SSH error."
msgstr "خطأ SSH غير معروف."

#: obour/remote.py:223
msgid "Timed out while copying the cursor theme."
msgstr "انتهت المهلة أثناء نسخ سمة المؤشر."

#: obour/remote.py:245
#, python-brace-format
msgid "SSH connection — {error}"
msgstr "اتصال SSH — {error}"

#: obour/remote.py:247
#, python-brace-format
msgid "SSH connection ({os})"
msgstr "اتصال SSH ‏({os})"

#: obour/remote.py:248
msgid "SSH connection"
msgstr "اتصال SSH"

#: obour/remote.py:265
#, python-brace-format
msgid "install {packages} on the host (⋮ → Set Up Host…)"
msgstr "ثبّت {packages} على المضيف (⋮ ← إعداد المضيف…)"

